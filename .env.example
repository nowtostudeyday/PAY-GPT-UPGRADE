# ===== Server =====
PORT=3000
JSON_BODY_LIMIT=15mb
ADMIN_TOKEN_SECRET=         # 留空将基于 cwd 派生
ADMIN_EMAIL=admin@vru.cc    # 首次建库时的默认管理员邮箱
ADMIN_PASSWORD=admin123     # 首次建库时的默认登录密码
ADMIN_SECONDARY_PASSWORD=admin123  # 首次建库时的默认二级密码（卡池/CDK/Session）
ADMIN_LOGIN_PATH=admin-login      # 首次建库时的默认登录入口路径（可后台修改）
ADMIN_PANEL_PATH=admin          # 首次建库时的默认管理后台路径（可后台修改）

# ===== 卡片供应商 Webhook =====
# 首次部署时可填写，启动后会迁入 MySQL；后续推荐在后台「系统配置 → 卡片供应商开卡 Webhook」管理
# 仅用于验证和解密 CARD_ISSUE 事件；不要填供应商 API Key 或 API Secret
CARD_SUPPLIER_WEBHOOK_SECRET=

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=                # 必填：MySQL 密码
DB_NAME=plus_papay
DB_POOL_LIMIT=60

# ===== 浏览器 =====
HEADFUL=0                   # 1 = 有头模式（调试用）
CHROMIUM_CHANNEL=           # 留空使用 Playwright 自带 Chromium；可选 chrome / msedge
BROWSER_POOL=1                # 1 = 默认启用浏览器池；也可在后台「浏览器池」页切换（写入 MySQL，优先生效）
BROWSER_POOL_SIZE=2           # 池大小，建议与前台并发一致
BROWSER_POOL_MAX_SIZE=24      # 槽位上限（128G 独服可设 16–24）
BROWSER_POOL_BASE_PORT=19222  # 槽位 CDP 起始端口（slot-N 使用 BASE+N）
# hCaptcha VLM（推荐写在这里，重建 app 容器自动同步到 MySQL；亦可在后台保存）
# HCAPTCHA_VLM_API_KEY=sk-...
# HCAPTCHA_VLM_BASE_URL=https://api.openai.com/v1
# HCAPTCHA_VLM_MODEL=gpt-5.5
# 打码平台（createTask/getTaskResult，推荐用于 passive checkbox 兜底）
# HCAPTCHA_CAPTCHA_PLATFORM_API_KEY=CAP-...
# HCAPTCHA_CAPTCHA_PLATFORM_API_URL=https://api.capsolver.com
# HCAPTCHA_CAPTCHA_PLATFORM_TIMEOUT=180
# Session Cookie（Checkout 页面登录必需，与 AccessToken 不同）
# 从浏览器 DevTools → Application → Cookies → chatgpt.com 复制 __Secure-next-auth.session-token
# 建议导出全部 chatgpt.com Cookie，写入 Session JSON 的 cookies[] 或 cookieHeader 字段
# CHATGPT_SESSION_COOKIE=
# 裸机部署时 install.sh 会写入 HCAPTCHA_SOLVER_PYTHON
HCAPTCHA_SOLVER_PYTHON=

# ===== ChatGPT / Stripe（用于创建 Plus 订单的客户端 token，构建时由后端动态注入即可）=====
CHATGPT_TOKEN=
STRIPE_KEY=

# ===== Billing 默认值（可选；不填则全部从「资产池」按任务取卡 / 取地址）=====
BILLING_COUNTRY=US
BILLING_ADDRESS=
BILLING_CITY=
BILLING_STATE=
BILLING_ZIP=
BILLING_NAME=
BILLING_PHONE=

# ===== 银行卡（建议放在「资产池」管理，不要走环境变量）=====
CARD_NUMBER=
CARD_EXPIRY=
CARD_CVC=

# ===== 代理（强烈建议使用住宅代理，支持 {session} 占位符做 sticky session）=====
# 示例：http://USER:PASS@your-proxy-host:1000
# 示例：http://USER-session-{session}:PASS@your-proxy-host:1000
PROXY=

# ===== 邮箱通道 =====
# 临时邮箱 API（兼容 cloudflare_temp_email）
INBOX_API_BASE=             # 如：https://your-temp-email.example.com
# 临时邮箱可用域名（多行/逗号分隔）；为空则由后台「系统配置」管理
INBOX_EMAIL_DOMAINS=
# 自定义随机邮箱域名（用于 OpenAI 注册）
RANDOM_EMAIL_DOMAIN=
